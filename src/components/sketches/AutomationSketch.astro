---
// Papeles desordenados entran a un engrane y salen como una tabla limpia con palomitas.
---

<svg class="sketch automation" viewBox="0 0 400 240" role="img" aria-hidden="true">
  <defs>
    <filter id="pencilAutomation" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
      <feDisplacementMap in="SourceGraphic" scale="2.6" />
    </filter>
  </defs>
  <g filter="url(#pencilAutomation)">
    <!-- papeles que viajan hacia el engrane -->
    <g class="paper p1">
      <path d="M30 80 L74 74 L80 128 L36 134 Z" />
      <path class="faint" d="M38 90 L70 86 M39 100 L72 96 M40 110 L66 107" />
    </g>
    <g class="paper p2">
      <path d="M44 96 L86 104 L78 156 L36 148 Z" />
      <path class="faint" d="M48 108 L80 114 M46 120 L78 126 M45 132 L70 136" />
    </g>
    <g class="paper p3">
      <path d="M26 118 L68 112 L72 164 L30 170 Z" />
      <path class="faint" d="M33 128 L62 124 M34 140 L64 136 M35 152 L58 149" />
    </g>
    <!-- flechas -->
    <path class="faint" d="M108 121 Q 128 117 146 121 M138 114 L147 121 L138 128" />
    <path class="faint" d="M254 121 Q 266 118 280 121 M272 114 L281 121 L272 128" />
    <!-- engrane -->
    <g class="gear">
      <path d="M230.7 116.0 L239.8 116.4 L239.8 123.6 L230.7 124.0 L227.2 134.8 L234.3 140.5 L230.1 146.3 L222.5 141.3 L213.3 148.0 L215.7 156.8 L208.9 159.0 L205.7 150.5 L194.3 150.5 L191.1 159.0 L184.3 156.8 L186.7 148.0 L177.5 141.3 L169.9 146.3 L165.7 140.5 L172.8 134.8 L169.3 124.0 L160.2 123.6 L160.2 116.4 L169.3 116.0 L172.8 105.2 L165.7 99.5 L169.9 93.7 L177.5 98.7 L186.7 92.0 L184.3 83.2 L191.1 81.0 L194.3 89.5 L205.7 89.5 L208.9 81.0 L215.7 83.2 L213.3 92.0 L222.5 98.7 L230.1 93.7 L234.3 99.5 L227.2 105.2 Z" />
      <circle cx="200" cy="120" r="10" />
    </g>
    <!-- tabla limpia -->
    <path d="M292 70 L380 69 L381 172 L293 173 Z" />
    <path d="M292 88 L380 87" />
    <path class="faint" d="M293 109 L380 108 M293 130 L380 129 M293 151 L380 150 M352 70 L353 172" />
    <path class="check c1" d="M359 99 L364 104 L373 93" />
    <path class="check c2" d="M359 120 L364 125 L373 114" />
    <path class="check c3" d="M359 141 L364 146 L373 135" />
    <path class="check c4" d="M359 162 L364 167 L373 156" />
  </g>
</svg>

<style>
  .automation .gear {
    transform-box: view-box;
    transform-origin: 200px 120px;
    animation: gearSpin 6s linear infinite;
  }
  @keyframes gearSpin {
    to { transform: rotate(360deg); }
  }
  .automation .paper {
    transform-box: fill-box;
    transform-origin: center;
    animation: paperIn 6s ease-in infinite;
  }
  .automation .p2 { animation-delay: 2s; }
  .automation .p3 { animation-delay: 4s; }
  @keyframes paperIn {
    0% { transform: translate(0, 0); opacity: 1; }
    55% { transform: translate(105px, 0) scale(0.6); opacity: 0; }
    56%, 100% { transform: translate(0, 0); opacity: 0; }
  }
  .automation .check {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: tick 6s ease-out infinite;
  }
  .automation .c2 { animation-delay: 0.6s; }
  .automation .c3 { animation-delay: 1.2s; }
  .automation .c4 { animation-delay: 1.8s; }
  @keyframes tick {
    0%, 30% { stroke-dashoffset: 30; }
    40%, 90% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 30; }
  }
  @media (prefers-reduced-motion: reduce) {
    .automation .gear,
    .automation .paper,
    .automation .check {
      animation: none;
    }
    .automation .check {
      stroke-dashoffset: 0;
    }
  }
</style>
