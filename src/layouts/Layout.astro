---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import BaseHead from "./BaseHead.astro";

const {title} = Astro.props;



---

<!DOCTYPE html>
<html lang="en">
	<BaseHead title={title} description="Full-Stack Developer Portfolio"/>
	<body>
		<!-- <Navbar/> -->
		<slot />
		<!-- <Footer/> -->
		<script>
			import "../scripts/preferences";
		</script>
	</body>
</html>
<style is:global>
	:root {
		--accent-gradient: linear-gradient(10deg, #0059ff, #850068 30%, rgb(147, 107, 255) 60%);
		--nav-bg: #ffffff;
		--nav-text: #1c1f2a;
		--nav-shadow: rgba(0, 0, 0, 0.2);
		--surface: #f2f2f2;
		--surface-alt: #ffffff;
		--text: #1c1f2a;
		--accent: #4e66f8;
		--accent-hover: #505ebb;
	}
	:root[data-theme="dark"] {
		--nav-bg: #1f2333;
		--nav-text: #e6e8f0;
		--nav-shadow: rgba(0, 0, 0, 0.5);
		--surface: #151824;
		--surface-alt: #1f2333;
		--text: #e6e8f0;
		--accent: #6d82ff;
		--accent-hover: #5468e6;
	}
	html {
		font-family: system-ui, sans-serif;
		background-color: var(--surface);
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
</style>
